rules_version = '2';
// Linger live sync: each paired laptop + phone share one document, pairs/{code}.
// The 12-character random code is the only key, so only people with the code can read or write it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pairs/{code} {
      allow read: if code.size() >= 10;
      allow create, update: if code.size() >= 10
        && request.resource.data.keys().hasOnly(['words', 'updated'])
        && request.resource.data.words is map
        && request.resource.data.words.size() <= 300;
      allow delete: if false;
    }

    // Linger accounts (account.js): a signed-in user can read and write only their own profile and saved words.
    //   users/{uid}               profile and, later, settings
    //   users/{uid}/words/{key}   one saved word: w, m, s, p, place, date (strings, as in pairing) and timestamps.
    // Other fields are allowed (room for status, lookups, familiarity, reviews…) with a cap on how many and how big.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function optString(d, f, max) {
      return !(f in d) || (d[f] is string && d[f].size() <= max);
    }
    function validWord(d) {
      return d.size() <= 40
        && d.w is string && d.w.size() > 0 && d.w.size() <= 80
        && optString(d, 'm', 2000) && optString(d, 's', 2000) && optString(d, 'p', 2000)
        && optString(d, 'place', 200) && optString(d, 'date', 40)
        && (!('status' in d) || d.status in ['learning', 'mastered']);
    }
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.size() <= 40;
      match /words/{key} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && key.size() <= 64 && validWord(request.resource.data);
      }
    }

    // Beta feedback (beta.js): anyone using the beta can add a message; nobody can read, change or delete one from
    // the app. Read them in the Firebase console (Firestore → feedback).
    match /feedback/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['text', 'kind', 'screen', 'email', 'version', 'platform', 'installed', 'tester', 'ua', 'at', 'sentAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
        && request.resource.data.kind in ['bug', 'idea', 'other']
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.sentAt == request.time;
    }
  }
}
